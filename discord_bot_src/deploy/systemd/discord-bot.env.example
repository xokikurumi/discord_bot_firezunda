# Copy this file to /etc/discord-bot/discord-bot.env and set permissions to 600.
# Example:
#   sudo install -o root -g discord-bot -m 640 deploy/systemd/discord-bot.env.example /etc/discord-bot/discord-bot.env

DISCORD_TOKEN=replace-with-discord-bot-token

DB_USER=discord_bot
DB_PASSWORD=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=discord_bot

SLASH_COMMAND_SYNC_TO_GUILDS=true

OLLAMA_ANALYSIS_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=gemma4:latest
OLLAMA_REACTION_THRESHOLD=65
OLLAMA_DM_THRESHOLD=80
OLLAMA_CONFIDENCE_THRESHOLD=70
OLLAMA_REACTION_NOTIFY_GUILD_ID=0
OLLAMA_REACTION_NOTIFY_CHANNEL_ID=0
OLLAMA_REACTION_NOTIFY_MENTION=
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_CONTEXT_MAX_CHARS=1200
OLLAMA_MESSAGE_MAX_CHARS=1000
OLLAMA_NUM_PREDICT=512
OLLAMA_RETRY_CONTEXT_MAX_CHARS=500
OLLAMA_ANALYSIS_SYSTEM_PROMPT_PATH=/opt/discord/config/analysis_system_prompt.md
# Optional direct override. Prefer OLLAMA_ANALYSIS_SYSTEM_PROMPT_PATH for long prompts.
# OLLAMA_ANALYSIS_SYSTEM_PROMPT=
OLLAMA_ANALYSIS_USER_PROMPT_TEMPLATE="Previous chat context, oldest to newest:\n{context_text}\n\nLatest target message to score:\n{target_content}"
OLLAMA_ANALYSIS_FEWSHOT_PATH=/opt/discord/config/analysis_fewshot_examples.json
OLLAMA_ANALYSIS_FEWSHOT_MAX_EXAMPLES=5
OLLAMA_ANALYSIS_FEEDBACK_RAG_ENABLED=true
OLLAMA_ANALYSIS_FEEDBACK_RAG_CANDIDATE_LIMIT=50
OLLAMA_ANALYSIS_FEEDBACK_RAG_MAX_EXAMPLES=3
OLLAMA_ANALYSIS_FEEDBACK_RAG_MIN_SIMILARITY=25
OLLAMA_ANALYSIS_PROMPT_VERSION=analysis-feedback-rag-v1

COMMUNICATION_TREND_ANALYSIS_ENABLED=true
COMMUNICATION_TREND_GUILD_ANALYSIS_ENABLED=false
COMMUNICATION_TREND_CHECK_INTERVAL_SECONDS=86400
COMMUNICATION_TREND_MIN_USER_MESSAGES=1
COMMUNICATION_TREND_SAMPLE_LIMIT=30
COMMUNICATION_TREND_NUM_PREDICT=2048

P2PQUAKE_ENABLED=true
P2PQUAKE_WS_URL=wss://api.p2pquake.net/v2/ws
P2PQUAKE_RECONNECT_DELAY=10
P2PQUAKE_MIN_NOTIFY_SCALE=40
P2PQUAKE_IMAGE_FONT_PATH=/opt/discord/fonts/NotoSansCJKjp-Regular.otf

GSI_BLANK_TILE_BASE_URL=https://cyberjapandata.gsi.go.jp/xyz/blank
GSI_TILE_CACHE_DIR=cache/gsi_tiles
MESSAGE_FILE_BASE_PATH=files

GEOLONIA_JAPANESE_ADDRESSES_API_BASE_URL=https://geolonia.github.io/japanese-addresses/api/ja
GEOLONIA_ADDRESS_SYNC_ENABLED=true
GEOLONIA_ADDRESS_SYNC_INTERVAL_DAYS=90
GEOLONIA_ADDRESS_SYNC_CHECK_INTERVAL_SECONDS=21600

JMA_SHINDO_STATION_URL=https://www.data.jma.go.jp/eqev/data/kyoshin/jma-shindo.html
JMA_SHINDO_STATION_SYNC_ENABLED=true
JMA_SHINDO_STATION_SYNC_INTERVAL_DAYS=90
JMA_SHINDO_STATION_SYNC_CHECK_INTERVAL_SECONDS=21600

ICS_GUILD_EVENT_ENABLED=true
ICS_GUILD_EVENT_URL=https://vo.nrsy.jp/event-schedule.ics
ICS_GUILD_EVENT_INTERVAL_MONTHS=2
ICS_GUILD_EVENT_CHECK_INTERVAL_SECONDS=21600

NICONICO_USER_VIDEO_ENABLED=true

NICONICO_INFO_ENABLED=true
NICONICO_INFO_CHECK_INTERVAL_SECONDS=3600
NICONICO_INFO_TARGET_URLS=https://blog.nicovideo.jp/niconews/category/ge_maintenance,https://blog.nicovideo.jp/niconews/category/ge_user/
